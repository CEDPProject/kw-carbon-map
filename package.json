{
  "name": "air365-platform",
  "version": "1.0.0",
  "description": "안전공조시스템",
  "scripts": {
    "start": "ts-node-dev --no-notify --exit-child ./src/index.ts",
    "build": "tsc -p .",
    "build:live": "nodemon --watch '*.ts' --exec ts-node ./src/index.ts",
    "test": "vitest run",
    "dev": "env-cmd -f .env ts-node-dev --no-notify --exit-child ./src/index.ts",
    "prd": "env-cmd -f .env ts-node ./src/index.ts",
    "build:greenhouse": "tsc -p tsconfig.frontend.json",
    "sync:maplibre": "node scripts/copy-maplibre.mjs"
  },
  "dependencies": {
    "@amcharts/amcharts4": "^4.10.40",
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "datatables.net-dt": "^2.3.2",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "env-cmd": "^11.0.0",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "moment": "^2.29.4",
    "moment-timezone": "^0.6.0",
    "mysql2": "^3.6.5",
    "path": "^0.12.7",
    "reflect-metadata": "^0.1.13",
    "ts-node-dev": "^2.0.0",
    "typeorm": "^0.3.20",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.20",
    "@types/express-session": "^1.18.2",
    "@types/geojson": "^7946.0.16",
    "@types/moment": "^2.13.0",
    "@types/node": "^20.8.0",
    "maplibre-gl": "^6.9.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "air365",
    "platform"
  ],
  "author": "",
  "license": "ISC"
}
